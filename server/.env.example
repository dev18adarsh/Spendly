# ===========================================================================
# Spendly Server Environment Configuration
# ===========================================================================
# Copy this file to `.env` for local development. Never commit `.env` to Git.
# In production, configure these variables directly in your hosting dashboard
# (e.g. Render, Railway, Fly.io).

# ---------------------------------------------------------------------------
# HTTP & Server Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call the API via CORS.
# Local development:
#   http://localhost:5173
# Production (set to your Vercel frontend URL, plus custom domains):
#   https://spendly.vercel.app,https://spendly-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# Maximum number of documents a single page of results may return.
MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# Your Atlas connection string. Keep it in `.env` — never in source control
# and never in anything sent to the browser.
#
# Format:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Spendly
#
# In production, this variable is MANDATORY; the server will refuse to start without it.
MONGODB_URI=

# Name of the database inside the cluster.
MONGODB_DB_NAME=spendly

# How long to wait for MongoDB to select a server before failing (ms).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Authentication & Cookies
# ---------------------------------------------------------------------------
# How long a session stays valid (ms). The session is stored server-side.
# Default: 604800000 (7 days)
SESSION_TTL_MS=604800000

# `SameSite` policy for the session and CSRF cookies:
#   lax     — Default for local dev or same-domain deployment.
#   strict  — Stricter, but suppresses cookies on external link navigation.
#   none    — REQUIRED FOR CROSS-DOMAIN PRODUCTION DEPLOYMENTS (e.g., when the
#             frontend is on Vercel https://*.vercel.app and backend is on Render/Railway).
#             Note: `SameSite=none` automatically requires `COOKIE_SECURE=true`.
COOKIE_SAMESITE=lax

# Whether the cookies are marked `Secure` (HTTPS only).
# In production (`NODE_ENV=production`), defaults to `true`.
# Set to `true` whenever using HTTPS or cross-domain setup.
COOKIE_SECURE=false

# Optional cookie domain (e.g. `.spendly.com` for subdomain sharing).
COOKIE_DOMAIN=

# bcrypt cost factor. Defaults to 12 in production, 4 in automated tests.
BCRYPT_ROUNDS=12

# Failed sign-ins allowed per account before temporary lockout.
LOGIN_ATTEMPT_LIMIT=5

# How long an account stays locked after too many failed sign-ins (ms).
LOGIN_ATTEMPT_WINDOW_MS=900000

# Sign-in and registration requests allowed per IP within the window.
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=5

# Length of the rate-limit window in milliseconds (15 minutes).
RATE_LIMIT_WINDOW_MS=900000
