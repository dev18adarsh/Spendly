# Environment configuration for the Spendly API.
# Copy to `.env` and fill in the values you need. Never commit a real `.env`.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server runs on http://localhost:5173 by default.
CORS_ORIGINS=http://localhost:5173

# Maximum number of documents a single page of results may return.
MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# Your Atlas connection string. Keep it in `.env` — never in source control
# and never in anything sent to the browser.
#
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# Leave empty to start the server without a database: the API still boots,
# /api/health reports the problem and every data route answers 503.
MONGODB_URI=

# Name of the database inside the cluster.
MONGODB_DB_NAME=spendly

# How long to wait for MongoDB to select a server before failing (ms).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# How long a session stays valid (ms). The session is stored server-side, so
# signing out really does revoke it.
SESSION_TTL_MS=604800000

# `SameSite` policy for the session and CSRF cookies.
#   lax     — default, and enough when the API and the frontend share a site
#   strict  — stricter, but breaks links from other sites
#   none    — required when the API runs on a different domain; needs
#             COOKIE_SECURE=true because browsers only accept it over HTTPS
COOKIE_SAMESITE=lax

# Whether the cookies are marked `Secure`. Defaults to on in production.
# Set to false only for local development over plain HTTP.
COOKIE_SECURE=

# Optional cookie domain, e.g. `.spendly.com` to share cookies with
# subdomains. Leave empty to scope the cookies to the API's own host.
COOKIE_DOMAIN=

# bcrypt cost factor. 12 is a good production value; the test suite lowers
# it on its own.
BCRYPT_ROUNDS=

# Failed sign-ins allowed per account before it is temporarily locked.
LOGIN_ATTEMPT_LIMIT=5

# How long an account stays locked after too many failed sign-ins (ms).
LOGIN_ATTEMPT_WINDOW_MS=900000

# Sign-in and registration requests allowed per IP within the window.
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=5

# Length of the rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=900000
