# Environment configuration for the Spendly API.
# Copy to `.env` and fill in the values you need. Never commit a real `.env`.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server runs on http://localhost:5173 by default.
CORS_ORIGINS=http://localhost:5173

# Maximum number of documents a single page of results may return.
MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# Your Atlas connection string. Keep it in `.env` — never in source control
# and never in anything sent to the browser.
#
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# Leave empty to start the server without a database: the API still boots,
# /api/health reports the problem and every data route answers 503.
MONGODB_URI=

# Name of the database inside the cluster.
MONGODB_DB_NAME=spendly

# How long to wait for MongoDB to select a server before failing (ms).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
