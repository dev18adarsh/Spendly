# ===========================================================================
# Spendly Client Environment Configuration
# ===========================================================================
# Copy this file to `.env.local` for local development, or configure these
# environment variables in your Vercel Project Settings (Settings -> Environment Variables).

# Base URL for the Spendly Express REST API.
#
# Local development:
#   /api                      -> Vite dev proxy forwards to http://localhost:4000
#   http://localhost:4000/api -> Direct local API endpoint
#
# Production (e.g. Vercel frontend calling Render/Railway backend):
#   https://spendly-api.onrender.com/api
VITE_API_BASE_URL=/api

# Optional URL for Socket.IO real-time synchronization.
# If omitted, it is automatically derived from the origin of VITE_API_BASE_URL.
#
# Production:
#   https://spendly-api.onrender.com
# Local development:
#   Leave empty to use the same host / dev proxy
VITE_SOCKET_URL=

# Data source mode:
#   api  -> Connects to the live Express API + MongoDB database (REQUIRED FOR PRODUCTION).
#   mock -> Uses bundled client-side sample data (preview / offline demo only).
#
# For production deployment, always set:
#   VITE_DATA_SOURCE=api
VITE_DATA_SOURCE=mock
