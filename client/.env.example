# Client configuration. Copy to `.env.local` and adjust as needed.

# Base URL for the Spendly API.
#
#   /api                    the Vite dev server proxies /api to the API on
#                           http://localhost:4000 (see vite.config.ts)
#   http://localhost:4000/api
#                           call the API directly — use this when the client is
#                           served from a different origin than the API
VITE_API_BASE_URL=/api

# Where the UI reads its data from:
#   mock → sample data bundled with the app (default, nothing is persisted)
#   api  → the Express server (see ../server); set VITE_API_BASE_URL to
#          http://localhost:4000/api when the API runs on its own port
#
# The `api` source requires an account: the app asks the API who you are and
# shows the sign-in screen when nobody is signed in. The `mock` source is a
# preview build — it runs against sample data and signs you in automatically.
#
# Switching to `api`:
#   1. start the API   → npm run dev:server   (needs server/.env with MONGODB_URI)
#   2. seed the categories → npm run seed
#   3. set VITE_DATA_SOURCE=api here and restart the dev server
#   4. create an account on the sign-up screen
#
# Transactions and budgets created before authentication existed have no owner
# and are not reachable through the API — clear them before switching over.
VITE_DATA_SOURCE=mock
