# Client configuration. Copy to `.env.local` and adjust as needed.

# Base URL for the Spendly API.
VITE_API_BASE_URL=/api

# Where the UI reads its data from:
#   mock → sample data bundled with the app (default, nothing is persisted)
#   api  → the Express server (see ../server); set VITE_API_BASE_URL to
#          http://localhost:4000/api when the API runs on its own port
VITE_DATA_SOURCE=mock
