{
  "name": "spendly",
  "version": "0.1.0",
  "private": true,
  "description": "Spendly — premium expense tracking. Monorepo root (client + server).",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace server",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server",
    "test": "npm run test --workspace server",
    "seed": "npm run seed:categories --workspace server",
    "preview": "npm run preview --workspace client",
    "start:server": "npm run start --workspace server",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
